# Optional. The fictional example and manual planning work without a key.
CLOCKED_API_KEY=
# Live calls stay disabled until explicitly enabled. They consume provider credits.
CLOCKED_ENABLED=false
PORT=4317

# Hosted Worker only: LIVE_ACCESS_TOKEN is a private, high-entropy owner access code.
# Configure it as a Worker secret; never publish it or use CLOCKED_API_KEY as the code.
# LIVE_DAILY_REQUEST_LIMIT controls the hosted daily provider-request allowance.
# Missing or non-finite values fall back to six; finite values are bounded to zero through twenty.
# Zero disables budgeted provider work. No hosted token or allowance value is supplied here.
