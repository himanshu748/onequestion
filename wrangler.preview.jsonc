// Isolated visual preview. Never add provider secrets or production database bindings.
{
  "name": "onequestion-ui-polish",
  "main": "cloud/worker.ts",
  "compatibility_date": "2026-11-09",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*",
      "/demo/onequestion-demo.mp4"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "onequestion-ui-polish",
      "database_id": "be5e48c2-c380-4b10-ae16-439f5e724d22",
      "migrations_dir": "cloud/migrations"
    }
  ],
  "vars": {
    "LIVE_DAILY_REQUEST_LIMIT": "0"
  },
  "observability": {
    "enabled": false
  }
}
